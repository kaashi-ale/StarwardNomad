; Engine configuration file.
; Starward Nomad - 3D Open-World Space Exploration for Godot 4.3+ (Android / Moto G04s Optimized)

config_version=5

[application]

config/name="Starward Nomad"
config/description="3D Open-World Space & Planetary Exploration Game optimized for Android (Moto G04s)"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://Systems/GameState.gd"
QualityManager="*res://Systems/QualityManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[input]

